# Copie para .env e ajuste conforme necessário. NÃO comite o .env real.

# Banco (porta 5434 quando 5432 está ocupada por outro projeto)
DB_NAME=trcon_site
DB_USERNAME=trcon
DB_PASSWORD=trcon
DB_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/trcon_site

# Backend
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# CORS: origem do frontend (Vite dev server)
TRCON_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# API interna (Sirius Marketing -> site backend)
TRCON_SITE_INTERNAL_API_KEY=dev-internal-key-change-me

# Notificação de lead por e-mail (Resend). Em local fica off por padrão.
# TRCON_SITE_MAIL_ENABLED=true
# TRCON_SITE_MAIL_API_KEY=re_xxxxxxxx
# TRCON_SITE_MAIL_FROM=Site TRCon <noreply@trcongroup.com.br>
# Chat institucional com IA. Use chave e orçamento separados do Sírius Marketing.
# TRCON_SITE_CHAT_ENABLED=true
# TRCON_SITE_CHAT_STUB_ENABLED=false
# TRCON_SITE_DEEPSEEK_API_KEY=sk-xxxxxxxx
# TRCON_SITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# TRCON_SITE_DEEPSEEK_MODEL=deepseek-flash
# TRCON_SITE_CHAT_MAX_OUTPUT_TOKENS=400
# TRCON_SITE_CHAT_MAX_HISTORY_TURNS=6
# TRCON_SITE_CHAT_RATE_LIMIT_PER_MINUTE=8
# TRCON_SITE_CHAT_MONTHLY_BUDGET_USD=10
# Valores conservadores de pico (sem cache), verificados em 29/09/2026.
# TRCON_SITE_CHAT_INPUT_COST_PER_1M_USD=0.30
# TRCON_SITE_CHAT_OUTPUT_COST_PER_1M_USD=1.20
# TRCON_SITE_LEAD_NOTIFY_TO=contato@trcongroup.com.br
